{
  "extends": "../../tsconfig.node.json",
  "include": [
    "../../src/main/env.d.ts",
    "../../src/preload/env.d.ts",
    "../../src/main/security/**/*.ts",
    "../../src/main/trench/trenchIo*.ts",
    "../../src/main/xpc/trenchIoSystem.handler.ts",
    "../../src/renderer/trench-io/**/*.ts",
    "../../src/shared/trench/trench.type.ts",
    "../../src/shared/trench/trenchIndex.type.ts",
    "../../src/shared/trench/trenchPerson.type.ts",
    "../../src/shared/trench/trenchPerson.validation.ts"
  ],
  "compilerOptions": {
