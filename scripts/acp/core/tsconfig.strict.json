{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "lib": [
      "ES2022"
    ]
  },
  "include": [
    "../../../src/main/acp/core/**/*.ts",
    "../../../src/main/acp/helpers/**/*.ts",
    "./*.ts"
  ]
}
