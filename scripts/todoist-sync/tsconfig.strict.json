{
  "extends": "../../tsconfig.node.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "noCheck": false,
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "baseUrl": "../..",
    "paths": {
      "@main/*": ["src/main/*"],
      "@preload/*": ["src/preload/*"],
      "@renderer/*": ["src/renderer/*"],
      "@shared/*": ["src/shared/*"],
      "@maestro-main/*": ["src/main/maestro/*"],
      "@maestro-shared/*": ["src/shared/maestro/*"]
    }
  },
  "include": [
    "*.ts",
    "../../src/preload/sqlite/todoistSync/**/*.ts",
    "../../src/main/env.d.ts",
    "../../src/renderer/home/src/stores/auth/todoistSyncActivation.service.ts",
    "../../src/renderer/home/src/stores/auth/todoistSyncSession.emitter.ts",
    "../../src/renderer/todo/src/store/todoMutation.service.ts",
    "../../src/renderer/todo/src/store/todoRefresh.service.ts",
    "../../src/renderer/todo/src/store/todoResult.guard.ts",
    "../../src/shared/todoistSync/**/*.ts",
    "../../src/shared/mcp/todoMcpDao.type.ts"
  ]
}
